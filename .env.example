# Copia este archivo como .env.local (en tu PC) o pega estas variables en Vercel.
# Están pensadas para el navegador: la "anon/publishable key" es PÚBLICA y segura gracias a RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
# Clave pública VAPID para notificaciones push (generada con: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# ---- SOLO EN VERCEL (servidor). NUNCA con prefijo VITE_ ----
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...      (secreta: solo en Vercel, nunca en el código)
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...              (secreta)
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# PUSH_SECRET=...                    (secreto compartido con Supabase)
